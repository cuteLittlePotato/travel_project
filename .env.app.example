# ============================================
# 云游坊 - 业务应用环境变量（docker-compose.app.yml 使用）
# 复制为服务器 /opt/travel/deploy/.env.app 后填写真实值
# 本模板不得包含任何真实密钥
# ============================================

# ---------- 后端 ----------
APP_ENV=production
JWT_SECRET_KEY=
# 至少 32 位随机串：python -c "import secrets;print(secrets.token_urlsafe(48))"

POSTGRES_DB=travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=

REDIS_PASSWORD=

NEO4J_USER=neo4j
NEO4J_PASSWORD=

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_DOCUMENTS=travel-documents

RABBITMQ_USER=travel
RABBITMQ_PASSWORD=

LITELLM_MASTER_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

LOG_LEVEL=INFO
LOG_JSON=true

# ---------- 端口映射 ----------
API_EXPOSE_PORT=18000
FRONTEND_EXPOSE_PORT=13001
