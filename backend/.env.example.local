# ============================================
# 云游坊 - 本地开发环境变量
#
# 用法：复制为 backend/.env
#   cp backend/.env.example.local backend/.env
#
# 模式：业务服务（API / Celery / 前端）跑在本机，
#       数据与服务（PG / Redis / Milvus / Neo4j / ES / MinIO / RabbitMQ / LiteLLM）
#       使用测试服务器 192.168.75.100 上已部署的实例，直接读写同一个测试库。
#
# 这样改代码即时生效（reload），不必每次重建镜像。
# ============================================

# ---------- 应用 ----------
APP_ENV=development
APP_NAME=云游坊
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- 安全 ----------
# 本地开发用固定值即可；生成方式：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=local-dev-only-secret-key-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 本地是 http，Cookie 不能设 Secure
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# ---------- PostgreSQL ----------
POSTGRES_HOST=192.168.75.100
POSTGRES_PORT=15432
POSTGRES_DB=travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=__FILL_FROM_SERVER__
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------- Redis ----------
REDIS_HOST=192.168.75.100
REDIS_PORT=16379
REDIS_PASSWORD=__FILL_FROM_SERVER__
# DB 0 业务使用，DB 1 被 Langfuse 占用
REDIS_DB_BUSINESS=0

# ---------- Milvus ----------
MILVUS_HOST=192.168.75.100
MILVUS_PORT=19530

# ---------- Neo4j ----------
NEO4J_URI=bolt://192.168.75.100:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__FILL_FROM_SERVER__
NEO4J_DATABASE=neo4j

# ---------- Elasticsearch ----------
ES_HOSTS=http://192.168.75.100:19200
ES_INDEX_PREFIX=travel

# ---------- MinIO ----------
MINIO_ENDPOINT=192.168.75.100:19000
MINIO_ACCESS_KEY=__FILL_FROM_SERVER__
MINIO_SECRET_KEY=__FILL_FROM_SERVER__
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=travel-documents
MINIO_PRESIGN_EXPIRE_SECONDS=3600

# ---------- RabbitMQ / Celery ----------
RABBITMQ_HOST=192.168.75.100
RABBITMQ_PORT=5672
RABBITMQ_USER=travel
RABBITMQ_PASSWORD=__FILL_FROM_SERVER__
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ---------- LiteLLM ----------
LITELLM_BASE_URL=http://192.168.75.100:14000
LITELLM_MASTER_KEY=__FILL_FROM_SERVER__

# ---------- Langfuse ----------
LANGFUSE_HOST=http://192.168.75.100:13000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 日志 ----------
LOG_LEVEL=DEBUG
LOG_JSON=false
