# ============================================
# 云游坊 - 后端环境变量模板
# 复制为 backend/.env 后填写真实值；本文件不得包含任何真实密钥
# ============================================

# ---------- 应用 ----------
APP_ENV=development
APP_NAME=云游坊
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
# 逗号分隔的允许来源列表
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- 安全 ----------
# 至少 32 位；生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# ---------- PostgreSQL ----------
POSTGRES_HOST=192.168.75.100
POSTGRES_PORT=15432
POSTGRES_DB=travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------- Redis ----------
REDIS_HOST=192.168.75.100
REDIS_PORT=16379
REDIS_PASSWORD=
# DB 0 业务使用，DB 1 被 Langfuse 占用，业务代码禁止使用
REDIS_DB_BUSINESS=0
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECT_TIMEOUT=3.0
REDIS_SOCKET_TIMEOUT=3.0
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_BACKOFF_BASE=0.1
REDIS_KEY_PREFIX=travel

# ---------- Milvus ----------
MILVUS_HOST=192.168.75.100
MILVUS_PORT=19530

# ---------- Neo4j ----------
NEO4J_URI=bolt://192.168.75.100:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---------- Elasticsearch ----------
ES_HOSTS=http://192.168.75.100:19200
ES_INDEX_PREFIX=travel
ES_REQUEST_TIMEOUT=10.0
ES_MAX_RETRIES=3

# ---------- MinIO ----------
MINIO_ENDPOINT=192.168.75.100:19000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=travel-documents
MINIO_PRESIGN_EXPIRE_SECONDS=3600

# ---------- RabbitMQ / Celery ----------
RABBITMQ_HOST=192.168.75.100
RABBITMQ_PORT=5672
RABBITMQ_USER=travel
RABBITMQ_PASSWORD=
CELERY_LOCAL_QUEUE=local
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ---------- LiteLLM ----------
LITELLM_BASE_URL=http://192.168.75.100:14000
LITELLM_MASTER_KEY=

# ---------- Langfuse ----------
LANGFUSE_HOST=http://192.168.75.100:13000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 地图（占位：需求 §2.1.4 call_map_api，服务商未定） ----------
MAP_ENABLED=false
MAP_BASE_URL=
MAP_API_KEY=
MAP_TIMEOUT_SECONDS=5

# ---------- 短信（占位：enabled=false 时走 Mock 通道） ----------
SMS_ENABLED=false
SMS_BASE_URL=
SMS_API_KEY=
SMS_SIGN_NAME=
SMS_TIMEOUT_SECONDS=5

# ---------- 邮件（M01-T03 邮件验证码） ----------
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_USE_SSL=true

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_JSON=true
