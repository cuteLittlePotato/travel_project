  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "系统"
        ],
        "summary": "存活探针",
        "description": "仅判断进程存活，不探测外部依赖，避免级联失败。",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "系统"
        ],
        "summary": "就绪探针",
        "description": "探测全部依赖，任一不可用则返回 degraded。",
        "operationId": "readiness_api_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Readiness Api Health Ready Get"
                }
              }
            }
          }
        }
      }
    }
  }
